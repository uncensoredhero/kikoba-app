{
  "functions": {
    "api/index.ts": { "includeFiles": "public/**" },
    "api/[...path].ts": { "includeFiles": "public/**" },
    "api/v1/[...path].ts": { "includeFiles": "public/**" }
  },
  "rewrites": [
    { "source": "/", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/[...path]" }
  ]
}
