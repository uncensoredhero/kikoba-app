generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

enum GoalStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  EXPIRED
}
enum ContributionStatus {
  PENDING
  PARTIAL
  ON_TIME
  GRACE
  LATE
  MISSED
  RECOVERED
}
enum DepositStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REVERSED
}
enum AllocationMode {
  EXPLICIT
  AUTO_ALLOCATE
}
enum Priority {
  HIGH
  NORMAL
  LOW
}
enum EventType {
  DEPOSIT_SUCCESS
  DEPOSIT_REVERSED
  CONTRIBUTION_COMPLETED
  CONTRIBUTION_PARTIAL
  CONTRIBUTION_LATE
  CONTRIBUTION_MISSED
  CONTRIBUTION_RECOVERED
  GOAL_COMPLETED
  GOAL_CANCELLED
  GOAL_EXPIRED
  CHAMA_JOINED
  CHAMA_LEFT
  WITHDRAWAL_COMPLETED
}
enum ChamaType {
  LONG_TERM
  SHORT_TERM
}
enum ChamaFrequency {
  WEEKLY
  MONTHLY
}
enum MembershipRole {
  CREATOR
  ADMIN
  MEMBER
}
enum MembershipStatus {
  ACTIVE
  LEFT
  REMOVED
  PENDING
}
enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

model User {
  id String @id @default(cuid())
  email String @unique
  name String
  username String @unique
  profilePhotoUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  goals SavingsGoal[]
  deposits Deposit[]
  contributions ExpectedContribution[]
  scores UserScore[]
  features ScoreFeature[]
  events FinancialEvent[]
  memberships ChamaMember[]
  ownedChamas Chama[] @relation("ChamaOwner")
  sentFriendRequests FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestReceiver")
  friendshipsA Friendship[] @relation("FriendshipUserA")
  friendshipsB Friendship[] @relation("FriendshipUserB")
  sentMessages Message[] @relation("MessageSender")
  conversationMemberships ConversationMember[]
}

model Chama {
  id String @id @default(cuid())
  name String
  description String?
  type ChamaType
  contribution Decimal @db.Decimal(18,2)
  frequency ChamaFrequency
  maxMembers Int
  minTier String
  goal String?
  status String @default("ACTIVE")
  ownerId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User @relation("ChamaOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members ChamaMember[]
  conversation Conversation?
  @@index([status, type, frequency])
  @@index([ownerId])
}

model ChamaMember {
  id String @id @default(cuid())
  chamaId String
  userId String
  role MembershipRole @default(MEMBER)
  status MembershipStatus @default(ACTIVE)
  joinedAt DateTime @default(now())
  leftAt DateTime?
  chama Chama @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([chamaId, userId])
  @@index([userId, status])
  @@index([chamaId, status])
}

model FriendRequest {
  id String @id @default(cuid())
  fromId String
  toId String
  status FriendRequestStatus @default(PENDING)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  from User @relation("FriendRequestSender", fields: [fromId], references: [id], onDelete: Cascade)
  to User @relation("FriendRequestReceiver", fields: [toId], references: [id], onDelete: Cascade)
  @@index([toId, status])
  @@index([fromId, status])
}

model Friendship {
  id String @id @default(cuid())
  userAId String
  userBId String
  createdAt DateTime @default(now())
  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)
  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model Conversation {
  id String @id @default(cuid())
  chamaId String? @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  chama Chama? @relation(fields: [chamaId], references: [id], onDelete: Cascade)
  members ConversationMember[]
  messages Message[]
}

model ConversationMember {
  id String @id @default(cuid())
  conversationId String
  userId String
  joinedAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id String @id @default(cuid())
  conversationId String
  senderId String
  body String @db.Text
  createdAt DateTime @default(now())
  editedAt DateTime?
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model SavingsGoal {
  id String @id @default(cuid())
  userId String
  name String
  targetAmount Decimal @db.Decimal(18,2)
  targetDate DateTime?
  expectedAmount Decimal @db.Decimal(18,2)
  frequency String
  priority Priority @default(NORMAL)
  status GoalStatus @default(DRAFT)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions ExpectedContribution[]
}

model ExpectedContribution {
  id String @id @default(cuid())
  userId String
  goalId String?
  expectedAmount Decimal @db.Decimal(18,2)
  amountPaid Decimal @default(0) @db.Decimal(18,2)
  dueDate DateTime
  gracePeriodEnd DateTime
  status ContributionStatus @default(PENDING)
  completedAt DateTime?
  recoveredAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal SavingsGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)
  allocations DepositAllocation[]
  @@index([userId, dueDate, status])
}

model Deposit {
  id String @id @default(cuid())
  userId String
  amount Decimal @db.Decimal(18,2)
  destinationGoalId String?
  allocationMode AllocationMode @default(EXPLICIT)
  status DepositStatus @default(PENDING)
  source String?
  createdAt DateTime @default(now())
  reversedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  allocations DepositAllocation[]
}

model DepositAllocation {
  id String @id @default(cuid())
  depositId String
  contributionId String
  amount Decimal @db.Decimal(18,2)
  createdAt DateTime @default(now())
  reversedAt DateTime?
  deposit Deposit @relation(fields: [depositId], references: [id], onDelete: Cascade)
  contribution ExpectedContribution @relation(fields: [contributionId], references: [id], onDelete: Cascade)
  @@index([depositId])
  @@index([contributionId])
}

model FinancialEvent {
  id String @id @default(cuid())
  userId String
  type EventType
  entityType String
  entityId String
  metadata Json?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}

model ScoreFeature {
  id String @id @default(cuid())
  userId String
  consistency Float
  goalCompletion Float
  streak Float
  amountReliability Float
  timing Float
  recovery Float
  momentum Float
  commitmentLoad Float
  participationReliability Float
  confidence Float
  eventCount Int
  calculatedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UserScore {
  id String @id @default(cuid())
  userId String
  score Int
  confidence Float
  profile String
  reason String?
  featureSnapshot Json
  calculatedAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, calculatedAt])
}
